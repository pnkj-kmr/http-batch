[
  {
    "name": "nodes-inventory",
    "vars": {
      "base_url": "http://localhost:7070",
      "username": "infraon",
      "password": "infraon"
    },
    "defaults": {
      "timeout_ms": 10000,
      "verify_ssl": false,
      "headers": {
        "Content-Type": "application/json"
      },
      "expect": { "status": [200, 201, 207] },
      "retry": {
        "count": 1,
        "delay_ms": 1000,
        "backoff": "exponential",
        "retry_on": [429, 500, 502, 503, 504],
        "retry_on_errors": ["timeout", "connection_error"]
      },
      "pagination": {
        "type": "offset",
        "offset_param": "offset",
        "limit_param": "limit",
        "stop_when": ["short_page", "empty_or_not_list", "repeated_page"]
      }
    },
    "steps": [
      {
        "id": "token_generate",
        "request": {
          "url": "{{vars.base_url}}/openApi/token/generate",
          "method": "POST",
          "headers": {},
          "data": {
            "source": "{{vars.username}}",
            "key": "{{vars.password}}"
          }
        },
        "pagination": { "type": "none" },
        "response": {
          "type": "object",
          "from": "$",
          "fields": { "token": ["token", "auth-token", "jwt"] }
        }
      },
      {
        "id": "fetch_nodes",
        "depends_on": ["token_generate"],
        "request": {
          "url": "{{vars.base_url}}/openApi/resourceInventoryManagementV2/v4/resource",
          "method": "GET",
          "headers": {
            "Authorization": "Bearer {{token_generate.token}}"
          },
          "params": {
            "objectType": "Node",
            "limit": 100,
            "offset": 0
          }
        },
        "response": {
          "type": "list",
          "from": "$",
          "fields": { "ip": "ipAddress" }
        },
        "on_status": {
          "401": { "rerun": "token_generate", "max": 1 }
        }
      },
      {
        "id": "get_components",
        "depends_on": ["token_generate", "fetch_nodes"],
        "foreach": "fetch_nodes",
        "request": {
          "url": "{{vars.base_url}}/openApi/resourceInventoryManagementV2/v4/resource",
          "method": "GET",
          "headers": {
            "Authorization": "Bearer {{token_generate.token}}"
          },
          "params": {
            "objectType": "component",
            "ipAddress": "{{fetch_nodes.ip}}",
            "limit": 250,
            "offset": 0
          }
        },
        "on_status": {
          "401": { "rerun": "token_generate", "max": 1 }
        }
      },
      {
        "id": "get_resources",
        "depends_on": ["token_generate", "fetch_nodes"],
        "foreach": "fetch_nodes",
        "request": {
          "url": "{{vars.base_url}}/openApi/resourceInventoryManagementV2/v4/resource",
          "method": "GET",
          "headers": {
            "Authorization": "Bearer {{token_generate.token}}"
          },
          "params": {
            "objectType": "resource",
            "ipAddress": "{{fetch_nodes.ip}}",
            "limit": 250,
            "offset": 0
          }
        },
        "on_status": {
          "401": { "rerun": "token_generate", "max": 1 }
        }
      }
    ]
  },
  {
    "name": "topology",
    "vars": {
      "base_url": "http://localhost:7070",
      "username": "YOUR_USERNAME",
      "password": "YOUR_PASSWORD",
      "topology_protocols": ["GPON", "DWDM", "SDH", "PDH", "LLDP", "CDP", "ISIS", "OSPF", "BGP"]
    },
    "defaults": {
      "timeout_ms": 10000,
      "verify_ssl": false,
      "headers": {
        "Content-Type": "application/json"
      },
      "expect": { "status": [200, 201, 207] },
      "retry": {
        "count": 1,
        "delay_ms": 1000,
        "backoff": "exponential",
        "retry_on": [429, 500, 502, 503, 504],
        "retry_on_errors": ["timeout", "connection_error"]
      },
      "pagination": {
        "type": "offset",
        "offset_param": "offset",
        "limit_param": "limit",
        "stop_when": ["short_page", "empty_or_not_list", "repeated_page"]
      }
    },
    "steps": [
      {
        "id": "token_generate",
        "request": {
          "url": "{{vars.base_url}}/openApi/token/generate",
          "method": "POST",
          "headers": {},
          "data": {
            "source": "{{vars.username}}",
            "key": "{{vars.password}}"
          }
        },
        "pagination": { "type": "none" },
        "response": {
          "type": "object",
          "from": "$",
          "fields": { "token": ["token", "auth-token", "jwt"] }
        }
      },
      {
        "id": "get_topology",
        "depends_on": ["token_generate"],
        "foreach": "vars.topology_protocols",
        "request": {
          "url": "{{vars.base_url}}/openApi/resourceInventoryManagementV2/v4/resource",
          "method": "GET",
          "headers": {
            "Authorization": "Bearer {{token_generate.token}}"
          },
          "params": {
            "objectType": "topology",
            "category": "{{vars.topology_protocols}}",
            "limit": 250,
            "offset": 0
          }
        },
        "on_status": {
          "401": { "rerun": "token_generate", "max": 1 }
        }
      }
    ]
  },
